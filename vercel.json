{
  "version": 2,
  "name": "mission-sanitation-web",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://missionsanitation.net"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
